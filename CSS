/* =========================================
   EXPERIENCE PAGE

.experience-page {
    width: 90%;
    max-width: 1180px;
    margin: 0 auto;
    color: #242824;
}

.experience-page *,
.experience-page *::before,
.experience-page *::after {
    box-sizing: border-box;
}

/* HERO AND ACTIONS */

.experience-page .experience-hero-actions,
.experience-page .experience-resume-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
}

.experience-page .experience-hero-actions .button,
.experience-page .experience-resume-actions .button,
.experience-page .experience-resume .button {
    margin: 0;
}

/* SECTION LABELS */

.experience-page .section-label {
    color: #526b57;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.6;
}

/* SECTIONS */

.experience-page .experience-section {
    padding: 55px 0;
}

.experience-page .experience-section h2 {
    margin-top: 10px;
    margin-bottom: 18px;
}

.experience-page .experience-section .about-page-text {
    max-width: 760px;
    line-height: 1.85;
}

/* EXPERIENCE TIMELINE */

.experience-page .experience-timeline {
    margin: 38px 0 0 8px;
    padding-left: 30px;
    border-left: 2px solid #e2e6e1;
}

.experience-page .experience-item {
    position: relative;
    min-width: 0;
    padding-bottom: 42px;
}

.experience-page .experience-item:last-child {
    padding-bottom: 0;
}

.experience-page .experience-item::before {
    content: "";
    position: absolute;
    top: 7px;
    left: -38px;
    width: 12px;
    height: 12px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #526b57;
    box-shadow: 0 0 0 1px #526b57;
}

.experience-page .experience-item-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 8px 16px;
}

.experience-page .experience-item-heading > div {
    flex: 1 1 280px;
    min-width: 0;
}

