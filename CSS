
/* BASIC RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* PAGE */
body {
    font-family: Arial, Helvetica, sans-serif;
    color: #242824;
    min-height: 100vh;

    background:
        radial-gradient(
            ellipse at 90% 10%,
            rgba(120, 150, 110, 0.28),
            transparent 42%
        ),
        radial-gradient(
            ellipse at 5% 85%,
            rgba(164, 183, 154, 0.30),
            transparent 38%
        ),
        radial-gradient(
            ellipse at 55% 55%,
            rgba(255, 255, 255, 0.55),
            transparent 65%
        ),
        linear-gradient(
            135deg,
            #f7f8f4 0%,
            #edf2e9 50%,
            #e2eadd 100%
        );
}

/* NAVIGATION */
.site-header {
    padding: 25px 0;
}

.navbar {
    width: 90%;
    max-width: 1180px;
    margin: 0 auto;

    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.15rem;
    font-weight: 700;
    white-space: nowrap;
    color: #526b57;
    text-decoration: none;
	transition: color 0.2s ease;
}
.logo:hover {
    color: #354c3b;
}

.nav-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 30px;

    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-links li {
    display: inline-block;
}

.nav-links a {
    color: #687068;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;

    transition: color 0.2s ease;
}

.nav-links a:hover {
    color: #242824;
}

.nav-links a.active {
    color: #242824;
}
.hero {
    width: 90%;
    max-width: 1180px;
    min-height: 75vh;

    margin: 0 auto;

    display: flex;
    align-items: center;

    padding: 80px 0;
}

.hero-content {
    max-width: 800px;
}

.eyebrow {
    margin-bottom: 20px;

    color: #000000;

    font-size: 0.85rem;
    font-weight: 700;

    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.hero h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);

    line-height: 1.05;

    letter-spacing: -0.04em;

    font-weight: 600;

    color: #000000;
}

.hero h1 span {
    display: block;

    color: #000000;
}

.hero-description {
    max-width: 600px;

    margin-top: 30px;

    color: #687068;

    font-size: 1.1rem;
}


/* =========================================
   HERO BUTTONS

.hero-buttons {
    display: flex;

    gap: 15px;

    margin-top: 35px;
}

.button {
    display: inline-block;

    padding: 13px 22px;

    border-radius: 7px;

    font-size: 0.9rem;
    font-weight: 600;

    text-decoration: none;

    transition:
        transform 0.2s ease,
        background-color 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    background-color: #242424;

    color: #ffffff;
}

.button-primary:hover {
    background-color: #526650;
}

.button-secondary {
    border: 1px solid #d0d7cc;

    background-color: transparent;

    color: #242424;
}

.button-secondary:hover {
    background-color: #ffffff;
}
