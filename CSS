/* =========================================
   SPORTS BROADCASTING — GREEN BACKGROUND
   ========================================= */

body {
    background-color: #f3f8ef;
    background-image:
        radial-gradient(
            ellipse at 15% 5%,
            rgba(166, 220, 151, 0.38),
            transparent 45%
        ),
        linear-gradient(
            135deg,
            #f5f9f0 0%,
            #e7f2df 50%,
            #f4f8ef 100%
        );
    background-attachment: fixed;
}


/* SUBTLE TECHNICAL GRID — NO DIAGONAL LINES */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;

    background-image:
        linear-gradient(
            rgba(65, 105, 66, 0.025) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(65, 105, 66, 0.025) 1px,
            transparent 1px
        );

    background-size: 48px 48px;
    opacity: 0.6;
}

/* Keep all website content above the background */

.site-header,
main,
.site-footer {
    position: relative;
    z-index: 1;
}



/* =========================================
   PROJECT CARDS — SUBTLE INTERACTION
   ========================================= */

.project-card {
    border: 1px solid rgba(55, 100, 56, 0.15);
    border-radius: 14px;
    overflow: hidden;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(44, 76, 43, 0.14);
}

/* Accessibility: reduce motion when requested */

@media (prefers-reduced-motion: reduce) {
    .project-card {
        transition: none;
    }

    .project-card:hover {
        transform: none;
    }
}
/* Remove all background patterns */
body::before,
body::after {
    content: none !important;
    display: none !important;
}

